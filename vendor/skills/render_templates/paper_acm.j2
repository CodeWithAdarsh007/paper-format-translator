{#- ACM sigconf (acmart).

    Authors/\affiliation/\email are declared in the preamble: acmart accepts that (probed: compiles,
    193 kB PDF) and it keeps their text out of the body, where the extractor would otherwise read it
    as a phantom lead-in section. \title, \begin{abstract} and \keywords stay before \maketitle, which
    is acmart's hard ordering rule; all three are already invisible to the paragraph scan.
-#}
{% from "_shared.j2" import render_title, render_macros, render_compat, render_float_support,
        render_content_support,
        authors_acm, render_section, render_floats, render_references with context %}
\documentclass[sigconf]{acmart}
{#- acmart already loads graphicx, amsmath, amssymb and xcolor, so only the table packages it does
    not provide are added here. -#}
\usepackage{booktabs}
\usepackage{multirow}
\usepackage{tabularx}
\usepackage{longtable}
\usepackage{tabulary}
\usepackage{colortbl}
\usepackage{bm}
\usepackage{makecell}
{{ render_float_support() }}
{#- acmart turns on microtype's glyph expansion before it checks for its own fonts, and it only
    loads the T1/Libertine set when libertine.sty, zi4.sty and newtxmath.sty all exist. On an image
    without them (Streamlit's, since texlive-fonts-extra was dropped in Session 11B) the document
    stays in the non-scalable fallback fonts and pdftex aborts every ACM build with
    "! pdfTeX error (font expansion): auto expansion is only possible with scalable fonts".
    Disabling expansion when the fonts are absent loses a typographic refinement, not the PDF. -#}
\IfFileExists{libertine.sty}{}{\AtBeginDocument{\ifcsname microtypesetup\endcsname
  \microtypesetup{expansion=false}\fi}}
{{ render_compat() }}
{{ render_content_support() }}
{{ render_macros(macros) }}
{{ authors_acm(metadata.authors) }}
\begin{document}

{{ render_title(metadata.title) }}

\begin{abstract}
{{ render_with_math(metadata.abstract | default("", true), metadata.get("abstract_math_spans") or []) }}
\end{abstract}

{% if metadata.keywords %}\keywords{ {{- metadata.keywords | map("texu") | join(", ") -}} }
{% endif %}
\maketitle

{% for section in sections %}{{ render_section(section, 0) }}{% endfor %}

{{ render_floats(pending_figures if pending_figures is defined else figures,
                 pending_tables if pending_tables is defined else tables) }}
% Nothing may be typeset after the references start: this flushes every float still queued.
\FloatBarrier

\bibliographystyle{ACM-Reference-Format}
{{ render_references(references) }}

\end{document}
