{#-
  _shared.j2 — macros shared by every paper template (Session 7).

  Content model: a SIR field's text was already run through sir_extractor.latex_to_text() on the
  way in, so it is plain text with the LaTeX punctuation left bare (& % # _ $). The renderer
  re-protects that punctuation OUTSIDE inline math; sir_extractor un-protects it on the way back
  out, which is what makes the round trip exact. Measured in render/policy_probe.py: 0.9996 of
  9,567 fields survive, versus 0.9963 if the text is emitted verbatim.

  tables[].latex and equations[].latex are verbatim LaTeX and are NEVER protected.

  Math (schema v2): a field may carry ``math_spans``; its text then holds «MATH_<i>» placeholders
  that render_with_math() swaps back for the raw math after escaping. The guillemets survive both
  the extractor's text conversion and protect_tex(). A v1 SIR has no math_spans and takes the
  plain ``| tex`` path unchanged.
-#}

{% macro render_compat() -%}
% Commands that preserved table/equation LaTeX uses but whose package a template may not load.
% \providecommand is a no-op wherever the real package does define them (acmart loads natbib).
\providecommand{\citep}[2][]{ \cite{ #2}}
\providecommand{\citet}[2][]{ \cite{ #2}}
\providecommand{\citealp}[2][]{ \cite{ #2}}
\providecommand{\citeauthor}[2][]{ #2}
\providecommand{\citeyear}[2][]{}
\providecommand{\sethlcolor}[1]{}
\providecommand{\hl}[1]{ #1}
\providecommand{\ul}[1]{ #1}
\providecommand{\st}[1]{ #1}
\providecommand{\so}[1]{ #1}
% UNICODE_MATH_MAP emits these for ® and ™; the LaTeX kernel defines them on current releases,
% the fallback keeps older installations compiling.
\providecommand{\textregistered}{(R)}
\providecommand{\texttrademark}{(TM)}
% acmart removes the deprecated font switches, but captured paper macros still expand to them
% (1709.08492 defines \Jcurr as {\cal J}). Only defined where the class left a hole.
\ifdefined\cal\else\let\cal\mathcal\fi
\ifdefined\bf\else\let\bf\bfseries\fi
\ifdefined\it\else\let\it\itshape\fi
\ifdefined\rm\else\let\rm\rmfamily\fi
\ifdefined\sf\else\let\sf\sffamily\fi
\ifdefined\tt\else\let\tt\ttfamily\fi
% \pgfmathparse lives in pgf (Debian: texlive-pictures), which none of the three classes loads.
% A paper-local colour-gradient macro that calls it otherwise fails with one "Undefined control
% sequence" per coloured cell (2402.12424: 108 errors per format). Reporting a flat lightness keeps
% the cell's own value printed and the colour at its lightest - degraded cosmetics, not lost text.
\providecommand{\pgfmathparse}[1]{\def\pgfmathresult{0}}
% Logic/typography packages the source loaded but the class templates deliberately do not: loading
% them when the image has them keeps their real behaviour, and the fallback keeps the document
% compiling when it does not. \ifdefstring is etoolbox (2402.12424's \applyGradientb branched on it:
% 20 undefined-cs errors), \usym is utfsym and prints a glyph by Unicode codepoint in a symbol font
% (7 more, in the open/closed column of a results table). A "?" is shown rather than nothing, so a
% substituted cell is visible instead of silently blank.
% The spaces inside the braces below are load-bearing twice over: TeX ignores them, but a brace
% followed by a percent or a hash would open a Jinja tag or comment and eat the macro body.
\IfFileExists{etoolbox.sty}{\usepackage{etoolbox}}{\providecommand{\ifdefstring}[4]{ #3}\providecommand{\ifdefstrequal}[4]{ #3}}
\providecommand{\usym}[1]{\textbf{?}}
% Preserved table bodies keep their wrapper (see sir_extractor.TABLE_WRAPPER_ENVS), so the wrapper
% has to exist here or the body it holds is lost: 2507.23194's tablenotes became
% "Environment threeparttable undefined". Both are in texlive-latex-extra, which the image installs;
% the fallback keeps the notes as plain text when it is not.
\IfFileExists{threeparttable.sty}{\usepackage{threeparttable}}{\newenvironment{threeparttable}{}{}\newenvironment{tablenotes}[1][]{}}
\providecommand{\tnote}[1]{ \textsuperscript{ #1}}
\IfFileExists{adjustbox.sty}{\usepackage{adjustbox}}{\newenvironment{adjustbox}[1]{}}
% A minipage side-by-side figure pair captions itself with \captionof (caption.sty) rather than
% \caption, and keeping the wrapper (2210.03629) means keeping that call. Loading caption on a class
% that already did is a no-op (probed: acmart + \usepackage{caption} compiles clean).
\IfFileExists{caption.sty}{\usepackage{caption}}{}
\ifcsname captionof\endcsname\else\providecommand{\captionof}[2]{ #1: #2}\fi
{%- endmacro %}

{% macro render_float_support() -%}
% ------------------------------------------------------------------ float placement (Session 13)
% Every float the renderer emits is pinned with the [H] option, so it is typeset exactly where it
% stands. float.sty is what defines H. Without it TeX treats a float as movable, which is how
% 2005.14165's Table II was typeset on top of its Table I.
\usepackage{graphicx}
\usepackage{float}
% placeins supplies \FloatBarrier, used once per document immediately before the reference list:
% that is what stops a float being typeset between two \bibitem entries. The [section] option is
% deliberately NOT requested - it patches \section, and acmart refuses that with
% "An attempt to redefine \section detected". It would be redundant anyway: every float here is
% [H], so TeX is never holding one over a section boundary in the first place.
\IfFileExists{placeins.sty}{\usepackage{placeins}}{\providecommand{\FloatBarrier}{\clearpage}}
% The tallest figure a page can hold. A float has no page-break inside it, so an uncapped figure
% that scaled taller than the measure simply ran off the bottom of the page - the "some images are
% cut down" report. totalheight (not height) only binds when the width-driven scale would overflow,
% so a figure that already fits is untouched.
\newcommand{\PFTFigMaxHeight}{0.82\textheight}
% A wide table is the other half of the "overlapping" report: GPT-3's eight-column Table I is
% typeset into a two-column IEEEtran page, and with no constraint its last column ran over the
% facing column. \PFTTableFit shrinks a table to the measure when it is too wide and leaves it
% untouched when it is not (adjustbox's max width never upscales). The two-step definition is
% deliberate: a parameter token inside another macro's argument (here, a #1 within the branches of
% \IfFileExists) is re-scanned when that argument becomes a definition and LaTeX aborts with
% "Illegal parameter number in definition of \reserved@a", so \PFTTableFit is defined at top level
% after the load has been tried.
\IfFileExists{adjustbox.sty}{\usepackage{adjustbox}}{}
\ifcsname adjustbox\endcsname
\newcommand{\PFTTableFit}[1]{\adjustbox{max width=\linewidth}{ #1}}
\else
\newcommand{\PFTTableFit}[1]{ #1}
\fi
% T1 is what makes \TH, \DH, \L, \O and the Cyrillic author names of a real manuscript typeset.
% OT1 (the LaTeX default, and what IEEEtran/llncs leave in place) has no slot for them and aborts:
% "Command \TH unavailable in encoding OT1".
\usepackage[T1]{fontenc}
{%- endmacro %}

{% macro render_macros(macros) -%}
{%- for d in macros or [] %}
{{ d }}
{%- endfor %}
{%- endmacro %}

{% macro render_title(title) -%}
\title{ {{- title | default("Untitled", true) | texu -}} }
{%- endmacro %}

{% macro authors_ieee(authors, keywords=[]) -%}
{%- set people = authors or [] -%}
\author{
{%- if people | length > 8 %}
{#- IEEEtran conference mode lays \and-separated blocks out in two columns and is meant for a
    handful of authors. With 32 (2005.14165) the column machinery gives up and the names are
    typeset as one running paragraph, which is the "Rewon ChildAditya RameshDaniel M. Ziegler"
    report: no separator at all. A long author list is printed by IEEE as one comma-separated
    block, which is what this branch emits. 8 is the point where the two-column layout stops
    fitting; papers at or under it keep the block-per-author form they render correctly with. -#}
\IEEEauthorblockN{\parbox[t]{\textwidth}{
{%- for a in people -%}
{%- if not loop.first %}{{ ", and " if loop.last else ", " }}{% endif -%}
{{- a.name | default("Anonymous", true) | texu -}}
{%- endfor -%}
}}
{%- set orgs = [] %}
{%- for a in people %}{% if a.affiliation and a.affiliation not in orgs %}{% set _ = orgs.append(a.affiliation) %}{% endif %}{% endfor %}
{%- if orgs %}
\IEEEauthorblockA{ {{- orgs | map("texu") | join(", ") -}} }
{%- endif %}
{%- else %}
{%- for a in people -%}
{%- if not loop.first %} \and {% endif -%}
\IEEEauthorblockN{ {{- a.name | default("Anonymous", true) | texu -}} }
{%- if a.affiliation %}
\IEEEauthorblockA{ {{- a.affiliation | texu -}} {%- if a.email %}\\ {{- a.email | texu -}} {% endif %}}
{%- endif -%}
{%- endfor -%}
{%- endif %}
{%- if keywords %}
\thanks{Index Terms---{{ keywords | map("texu") | join(", ") -}} }
{%- endif %}
}
{%- endmacro %}

{% macro authors_acm(authors) -%}
{%- for a in authors or [] -%}
\author{ {{- a.name | default("Anonymous", true) | texu -}} }
{%- if a.affiliation %}
{#- acmart raises "No country present for an affiliation" (a hard class error) when \country is
    absent. The SIR does not carry countries, and an empty one is accepted and prints nothing. -#}
\affiliation{\institution{ {{- a.affiliation | texu -}} }\country{}}
{%- endif -%}
{%- if a.email %}\email{ {{- a.email | texu -}} }{% endif %}
{%- endfor -%}
{%- endmacro %}

{% macro authors_llncs(authors) -%}
{%- set people = authors or [] -%}
\author{
{%- for a in people -%}
{%- if not loop.first %} \and {% endif -%}
{{- a.name | default("Anonymous", true) | texu -}} \inst{ {{- loop.index -}} }
{%- endfor %}
}
\institute{
{%- for a in people -%}
{%- if not loop.first %} \and {% endif -%}
{{- a.affiliation | default("Unspecified", true) | texu -}}
{%- if a.email %} \email{ {{- a.email | texu -}} }{% endif %}
{%- endfor %}
}
{%- endmacro %}

{% macro render_block(block) -%}
{%- set t = block.get("type") -%}
{#- The trailing newline is load-bearing: blocks are glued with a single "\n", so without it two
    consecutive paragraphs would become one LaTeX paragraph (and, since v2, one re-extraction chunk,
    which renumbers the «MATH_i» placeholders and breaks the round trip). -#}
{%- if t == "paragraph" -%}
{{ render_with_math(block.get("text", ""), block.get("math_spans") or []) ~ "\n" }}

{%- elif t == "equation" -%}
{%- set body = block.get("latex") or "" -%}
{%- if body | trim %}
{%- if block.get("label") and ("\\label{" ~ block["label"]) not in body %}
{% set body = insert_label(body, block["label"]) %}
{%- endif %}
{{ body }}

{%- endif -%}
{%- elif t in ("itemize", "enumerate") -%}
{%- set item_spans = block.get("math_spans") or [] -%}
\begin{ {{- t -}} }
{%- for it in block.get("items") or [] %}
\item {{ render_with_math(it, item_spans[loop.index0] if loop.index0 < item_spans | length else []) }}
{%- endfor %}
\end{ {{- t -}} }

{%- elif t in ("figure_ref", "table_ref", "ref") -%}
{{- block.get("xref") or ("\\ref{" ~ (block.get("label") | citekey) ~ "}") -}}
{%- elif t == "float" -%}
{%- if block.get("kind") == "table" -%}{{ render_table(block["float"]) }}
{%- else -%}{{ render_figure(block["float"]) }}
{%- endif -%}
{%- elif t == "citation" -%}
\cite{
{%- for k in block.get("keys") or [] -%}
{%- if not loop.first %},{% endif -%}
{{- k | citekey -}}
{%- endfor -%}
}
{%- endif -%}
{%- endmacro %}

{% macro render_section(section, depth=0) -%}
{%- set level = section.get("level", 1) -%}
{%- set heading = section.get("heading") -%}
{%- if section.get("_appendix_break") %}
{#- Class-specific, measured rather than assumed. IEEEtran conference mode's \appendix prints a
    bare "APPENDIX" line and then the section BODY -- the section TITLE is never typeset, which
    would have deleted all eight of GPT-3's appendix headings from the reader's document. Resetting
    the counter letters the sections A, B, C, keeps the heading, and makes \ref{appendix:...}
    resolve to "Appendix A". acmart and llncs typeset \appendix correctly (8/8 and 7/8 titles
    present in the real build), so they keep the command the source itself used. -#}
{% if format == "ieee" %}
\setcounter{section}{0}
\renewcommand{\thesection}{\Alph{section}}
{% else %}
\appendix
{% endif %}
{% endif -%}
{%- set heading_tex = render_with_math(heading, section.get("math_spans") or []) if heading is not none else "" -%}
{#- ``numbered`` is False only when the source wrote \section*: an unnumbered heading must stay
    unnumbered, or the paper gains numbered sections it never had (GPT-3's IX/X end matter). -#}
{%- set hstar = "*" if section.get("numbered") is sameas false else "" -%}
{%- if heading is not none and heading | trim -%}
{%- if level == 1 %}\section{{ hstar }}{ {{- heading_tex -}} }
{%- elif level == 2 %}\subsection{{ hstar }}{ {{- heading_tex -}} }
{%- elif level == 3 %}\subsubsection{{ hstar }}{ {{- heading_tex -}} }
{%- else %}\paragraph{{ hstar }}{ {{- heading_tex -}} }
{%- endif %}
{#- The source's own section label, so \ref{sec:...} resolves in the rebuilt document.
    extra_labels are \label commands the source wrote inside the section body rather than under
    the heading; they refer to the same section counter, so they are emitted here too. -#}
{%- if section.get("label") %} \label{ {{- section["label"] | citekey -}} }{% endif %}
{%- for extra in section.get("extra_labels") or [] %} \label{ {{- extra | citekey -}} }{% endfor %}

{%- elif level >= 1 %}\section{}

{%- endif -%}
{%- for b in section.get("blocks") or [] -%}
{{ b.get("_sep", "\n") }}{{ render_block(b) }}
{%- endfor -%}
{%- endmacro %}

{% macro render_figure(fig) -%}
\begin{figure}[{{ FLOAT_PLACEMENT }}]
{%- if fig.get("path") %}
\centering
\includegraphics[width={{ float_width(format, fig.get("span")) }},totalheight=\PFTFigMaxHeight,keepaspectratio]{ {{- fig["path"] | graphpath -}} }
{%- else %}
{#- A figure whose graphic the source drew as instructions (TikZ/PGF, pstricks, an \input graph
    file this pipeline did not inline) has no picture to place. It used to print
    "[Figure: the source drew this with TikZ/PGF, which this class does not load]" 56 times
    through GPT-3's body. The float stays, so the numbering, the \ref targets and the caption all
    survive; the missing artwork is left as blank space, not as an error message in the reader's
    paper. A \rule of zero width reserves a little height without typesetting anything. -#}
\rule{0pt}{4pt}
{%- endif %}
\caption{ {{- render_with_math(fig.get("caption") or "", fig.get("math_spans") or []) -}}
{%- if fig.get("label") %} \label{ {{- fig["label"] | citekey -}} }{% endif %} }
{#- subfigure/subfloat panel labels live inside this float: emitted here so \ref{mmlupro} resolves
    to the parent figure's number instead of being dropped as undefined. -#}
{%- for panel in fig.get("panel_labels") or [] %} \label{ {{- panel | citekey -}} }{% endfor %}
\end{figure}

{%- endmacro %}

{% macro render_table(tab) -%}
\begin{table}[{{ FLOAT_PLACEMENT }}]
\centering
\caption{ {{- render_with_math(tab.get("caption") or "", tab.get("math_spans") or []) -}}
{%- if tab.get("label") %} \label{ {{- tab["label"] | citekey -}} }{% endif %} }
\PFTTableFit{ {{- tab.get("latex") or "" -}} }
\end{table}

{%- endmacro %}

{% macro render_equation(eq) -%}
{%- set body = eq.get("latex") or "" -%}
{%- if eq.get("label") and ("\\label{" ~ eq["label"]) not in body %}
{% set body = insert_label(body, eq["label"]) %}
{%- endif -%}
{{ body }}
{%- endmacro %}

{% macro render_references(refs) -%}
\begin{thebibliography}{99}
{%- for r in refs or [] %}
\bibitem{ {{- r.get("key") | citekey -}} } {{ render_with_math(r.get("raw") or "", r.get("math_spans") or []) }}
{%- endfor %}
\end{thebibliography}
{%- endmacro %}

{% macro render_floats(figures, tables) -%}
{#- Only the floats that nothing in the body reference land here: renderer.anchor_floats() emits a
    labelled float right after the first block that cites it, so a figure sits where its own section
    discusses it instead of in a trailing pile (1706.03762's Figure 1: referenced page 2, was
    typeset page 5). TeX still keeps at most ~18 pending floats, so the flush every 20 stays for
    whatever is left (1709.08492: 73 figures + 6 tables). -#}
{%- for f in figures or [] %}
{{ render_figure(f) }}
{%- if loop.index % 20 == 0 %}
\clearpage
{%- endif -%}
{%- endfor -%}
{%- for t in tables or [] %}
{{ render_table(t) }}
{%- if loop.index % 20 == 0 %}
\clearpage
{%- endif -%}
{%- endfor -%}
{%- endmacro %}
